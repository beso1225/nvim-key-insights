{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suggestions"],
  "properties": {
    "schema_version": { "const": 1 },
    "suggestions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "title", "rationale", "evidence", "collision_check"],
        "properties": {
          "action": { "enum": ["learn_existing", "add_mapping", "change_mapping", "no_change"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 256 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "value"],
              "properties": {
                "metric": { "type": "string" },
                "value": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "collision_check": {
            "type": "object",
            "additionalProperties": false,
            "required": ["checked", "conflicting_mapping_ids"],
            "properties": {
              "checked": { "const": true },
              "conflicting_mapping_ids": {
                "type": "array",
                "maxItems": 4096,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
