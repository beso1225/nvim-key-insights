amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.12.4#/Taskfile.pkl"

local toolchainSources: Listing<String> = new {
  "flake.nix"
  "flake.lock"
}

local rustSources: Listing<String> = new {
  ...toolchainSources
  "Cargo.toml"
  "Cargo.lock"
  "codex/suggestions.schema.json"
  "crates/**/*.rs"
  "crates/**/Cargo.toml"
}

local luaSources: Listing<String> = new {
  ...toolchainSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "tests/lua/**/*.lua"
}

local e2eSources: Listing<String> = new {
  ...rustSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "tests/lua/e2e_spec.lua"
  "tests/lua/minimal_init.lua"
}

local workflowSources: Listing<String> = new {
  ...toolchainSources
  ".github/workflows/*.yml"
  ".github/workflows/*.yaml"
  "Taskfile.pkl"
  "tests/ci_contract.sh"
}

local packagingSources: Listing<String> = new {
  ...rustSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "docs/installation.md"
  "tests/packaging_contract.sh"
  "Taskfile.pkl"
}

local testRust: Task = new {
  name = "test:rust"
  description = "Run Rust unit and integration tests"
  cmd = "cargo test --workspace"
  inputs = rustSources
}

local testLua: Task = new {
  name = "test:lua"
  description = "Run headless Neovim collector tests"
  cmd = "nvim --headless -u tests/lua/minimal_init.lua -l tests/lua/run.lua"
  inputs = luaSources
}

local testE2e: Task = new {
  name = "test:e2e"
  description = "Run the headless collector-to-report privacy workflow"
  cmd = "KEY_INSIGHTS_BIN=target/debug/key-insights nvim --headless -u tests/lua/minimal_init.lua -l tests/lua/e2e_spec.lua"
  inputs = e2eSources
  deps { testRust }
}

local testPackaging: Task = new {
  name = "test:packaging"
  description = "Validate Nix package, app, and overlay outputs"
  cmd = "bash tests/packaging_contract.sh"
  inputs = packagingSources
}

local formatCheck: Task = new {
  name = "format:check"
  description = "Check Rust formatting"
  cmd = "cargo fmt --all -- --check"
  inputs = rustSources
}

local lintRust: Task = new {
  name = "lint:rust"
  description = "Run Clippy with warnings denied"
  cmd = "cargo clippy --workspace --all-targets -- -D warnings"
  inputs = rustSources
}

local lintActions: Task = new {
  name = "lint:actions"
  description = "Lint GitHub Actions workflows"
  cmd = "actionlint && bash tests/ci_contract.sh"
  inputs = workflowSources
}

local test: Task = new {
  name = "test"
  description = "Run all tests"
  deps { testLua; testE2e }
}

local check: Task = new {
  name = "check"
  description = "Run formatting, linting, and tests"
  deps { formatCheck; lintRust; lintActions; test; testPackaging }
}

local default: Task = new {
  name = "default"
  description = "Run the default project checks"
  deps { check }
}

tasks { testRust; testLua; testE2e; testPackaging; formatCheck; lintRust; lintActions; test; check; default }
