amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.12.4#/Taskfile.pkl"

local toolchainSources: Listing<String> = new {
  "flake.nix"
  "flake.lock"
}

local codexSchemaSources: Listing<String> = new {
  "codex/payload.schema.json"
  "codex/suggestions.schema.json"
}

local rustSources: Listing<String> = new {
  ...toolchainSources
  ...codexSchemaSources
  "Cargo.toml"
  "Cargo.lock"
  "crates/**/*"
}

local luaSources: Listing<String> = new {
  ...toolchainSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "tests/lua/**/*.lua"
}

local e2eSources: Listing<String> = new {
  ...rustSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "tests/e2e/**/*"
  "tests/lua/e2e_spec.lua"
  "tests/lua/minimal_init.lua"
  "tests/workflow_e2e.py"
}

local resourceSources: Listing<String> = new {
  ...rustSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "tests/lua/callback_performance_spec.lua"
  "tests/lua/minimal_init.lua"
  "tests/lua/resource_run.lua"
  "tests/lua/retention_spec.lua"
  "Taskfile.pkl"
}

local workflowSources: Listing<String> = new {
  ...toolchainSources
  ".github/workflows/*.yml"
  ".github/workflows/*.yaml"
  "Taskfile.pkl"
  "tests/ci_contract.sh"
  "tests/ci_platform_contract.py"
  "tests/release_workflow_contract.py"
}

local packagingSources: Listing<String> = new {
  ...rustSources
  "lua/**/*.lua"
  "plugin/**/*.lua"
  "plugins/nvim-key-insights/**/*"
  "docs/installation.md"
  "tests/packaging_contract.sh"
  "Taskfile.pkl"
}

local codexPluginSources: Listing<String> = new {
  ...toolchainSources
  ...codexSchemaSources
  ".agents/plugins/marketplace.json"
  "plugins/nvim-key-insights/**/*"
  "Cargo.toml"
  "crates/key-insights-cli/Cargo.toml"
  "tests/codex_plugin_contract.sh"
  "tests/codex_skill_contract.py"
  "tests/codex_plugin_workflow.sh"
  "Taskfile.pkl"
}

local releaseSources: Listing<String> = new {
  ...toolchainSources
  ...codexSchemaSources
  "Cargo.lock"
  "Cargo.toml"
  "CHANGELOG.md"
  "LICENSE*"
  "README.md"
  "crates/**/*"
  ".agents/plugins/marketplace.json"
  "plugins/nvim-key-insights/**/*"
  "docs/analyzer.md"
  "docs/event-schema.md"
  "docs/installation.md"
  "docs/releasing.md"
  "docs/schema-compatibility.md"
  "lua/key-insights/contract_versions.lua"
  "lua/key-insights/keymap_snapshot.lua"
  "lua/key-insights/report.lua"
  "lua/key-insights/schema.lua"
  "scripts/release.py"
  "tests/release_contract.py"
  "Taskfile.pkl"
}

local testRust: Task = new {
  name = "test:rust"
  description = "Run Rust unit and integration tests"
  cmd = "cargo test --workspace"
  inputs = rustSources
}

local testLua: Task = new {
  name = "test:lua"
  description = "Run headless Neovim collector tests"
  cmd = "nvim --headless -u tests/lua/minimal_init.lua -l tests/lua/run.lua"
  inputs = luaSources
}

local testE2e: Task = new {
  name = "test:e2e"
  description = "Run the headless collector and public-command privacy workflows"
  cmd = "KEY_INSIGHTS_BIN=target/debug/key-insights nvim --headless -u tests/lua/minimal_init.lua -l tests/lua/e2e_spec.lua && UV_CACHE_DIR=\"${TMPDIR:-/tmp}/nvim-key-insights-uv-cache\" KEY_INSIGHTS_BIN=target/debug/key-insights uv run --no-project --python-preference only-system python tests/workflow_e2e.py"
  inputs = e2eSources
  deps { testRust }
}

local testResourceRust: Task = new {
  name = "test:resource:rust"
  description = "Run deterministic Rust analyzer resource contracts"
  cmd = "cargo test --workspace"
  inputs = resourceSources
}

local testResourceLua: Task = new {
  name = "test:resource:lua"
  description = "Run collector callback and retention resource contracts"
  cmd = "nvim --headless -u tests/lua/minimal_init.lua -l tests/lua/resource_run.lua"
  inputs = resourceSources
}

local testResource: Task = new {
  name = "test:resource"
  description = "Run deterministic analyzer and collector resource contracts"
  deps { testResourceRust; testResourceLua }
}

local testPackaging: Task = new {
  name = "test:packaging"
  description = "Validate Nix package, app, and overlay outputs"
  cmd = "bash tests/packaging_contract.sh"
  inputs = packagingSources
}

local testCodexPlugin: Task = new {
  name = "test:codex-plugin"
  description = "Validate the installable Codex plugin and standalone skill"
  cmd = "bash tests/codex_plugin_contract.sh"
  inputs = codexPluginSources
}

local testCodexSkill: Task = new {
  name = "test:codex-skill"
  description = "Validate the semantic privacy and trust contract of the Codex skill"
  cmd = "python3 tests/codex_skill_contract.py"
  inputs = codexPluginSources
}

local testCodexPluginWorkflow: Task = new {
  name = "test:codex-plugin-workflow"
  description = "Exercise the privacy-safe manual skill validation workflow"
  cmd = "KEY_INSIGHTS_BIN=target/debug/key-insights bash tests/codex_plugin_workflow.sh"
  inputs = codexPluginSources
  deps { testRust }
}

local testRelease: Task = new {
  name = "test:release"
  description = "Validate synchronized release versions and safe version updates"
  cmd = "UV_CACHE_DIR=\"${TMPDIR:-/tmp}/nvim-key-insights-uv-cache\" uv run --python-preference only-system python tests/release_contract.py"
  inputs = releaseSources
}

local formatCheck: Task = new {
  name = "format:check"
  description = "Check Rust formatting"
  cmd = "cargo fmt --all -- --check"
  inputs = rustSources
}

local lintRust: Task = new {
  name = "lint:rust"
  description = "Run Clippy with warnings denied"
  cmd = "cargo clippy --workspace --all-targets -- -D warnings"
  inputs = rustSources
}

local lintActions: Task = new {
  name = "lint:actions"
  description = "Lint GitHub Actions workflows"
  cmd = "actionlint && bash tests/ci_contract.sh && python3 tests/ci_platform_contract.py && python3 tests/release_workflow_contract.py"
  inputs = workflowSources
}

local test: Task = new {
  name = "test"
  description = "Run all tests"
  deps { testLua; testE2e }
}

local check: Task = new {
  name = "check"
  description = "Run formatting, linting, and tests"
  deps { formatCheck; lintRust; lintActions; test; testResource; testPackaging; testCodexPlugin; testCodexSkill; testCodexPluginWorkflow; testRelease }
}

local default: Task = new {
  name = "default"
  description = "Run the default project checks"
  deps { check }
}

tasks { testRust; testLua; testE2e; testResourceRust; testResourceLua; testResource; testPackaging; testCodexPlugin; testCodexSkill; testCodexPluginWorkflow; testRelease; formatCheck; lintRust; lintActions; test; check; default }
